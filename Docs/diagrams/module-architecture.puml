@startuml module-architecture
skinparam componentStyle rectangle
skinparam linetype ortho
title Greater Cairo Transportation Network – Module Architecture

' ──────────────────────────────────────────────
' Legend
' ──────────────────────────────────────────────
legend top right
  |= Colour |= Meaning |
  |<#DDEEEE> cyan | shared infrastructure |
  |<#EEEEDD> yellow | neighborhood module |
  |<#EEDDEE> pink | facility module |
  |<#DDEEDD> green | road module |
  |<#FFEEDD> orange | traffic module |
  |<#EEEEFF> blue | transit module |
  |<#FFEEEE> red | graph (algorithms) module |
endlegend

' ──────────────────────────────────────────────
' HTTP layer (client)
' ──────────────────────────────────────────────
actor "HTTP Client\n(Browser / Postman)" as client

' ──────────────────────────────────────────────
' Root controller
' ──────────────────────────────────────────────
component "HomeController\nGET /" as home #white

client --> home

' ──────────────────────────────────────────────
' shared
' ──────────────────────────────────────────────
package "shared" #DDEEEE {
  component "CsvDatabaseSeeder\n(CommandLineRunner)" as seeder
  component "NodeRepository\n(JPA)" as nodeRepo
  component "AbstractNode\nAbstractEdge\n(JPA entities)" as sharedModel
}

' ──────────────────────────────────────────────
' neighborhood
' ──────────────────────────────────────────────
package "neighborhood" #EEEEDD {
  component "NeighborhoodController\nGET /api/neighborhoods" as nhCtrl
  component "NeighborhoodService" as nhSvc
  component "NeighborhoodRepository" as nhRepo
  nhCtrl --> nhSvc
  nhSvc --> nhRepo
}
client --> nhCtrl

' ──────────────────────────────────────────────
' facility
' ──────────────────────────────────────────────
package "facility" #EEDDEE {
  component "FacilityController\nGET /api/facilities" as fCtrl
  component "FacilityService" as fSvc
  component "FacilityRepository" as fRepo
  fCtrl --> fSvc
  fSvc --> fRepo
}
client --> fCtrl

' ──────────────────────────────────────────────
' road
' ──────────────────────────────────────────────
package "road" #DDEEDD {
  component "RoadController\nGET /api/roads\nGET /api/roads/maintenance-plan" as rCtrl
  component "PotentialRoadController\nGET /api/potential-roads" as prCtrl
  component "RoadService" as rSvc
  component "RoadRepository\nPotentialRoadRepository" as rRepo
  component "[PLACEHOLDER]\nDpMaintenanceService" as dpMaint #lightgray
  rCtrl --> rSvc
  rCtrl --> dpMaint
  prCtrl --> rSvc
  rSvc --> rRepo
}
client --> rCtrl
client --> prCtrl

' ──────────────────────────────────────────────
' traffic
' ──────────────────────────────────────────────
package "traffic" #FFEEDD {
  component "TrafficController\nGET /api/traffic\nGET /api/traffic/signal-timing" as tCtrl
  component "TrafficService" as tSvc
  component "TrafficPatternRepository" as tRepo
  component "[PLACEHOLDER]\nGreedySignalTimingService" as greedySvc #lightgray
  tCtrl --> tSvc
  tCtrl --> greedySvc
  tSvc --> tRepo
}
client --> tCtrl

' ──────────────────────────────────────────────
' transit
' ──────────────────────────────────────────────
package "transit" #EEEEFF {
  component "MetroController\nGET /api/metro\nGET /api/metro/frequency-optimisation" as mCtrl
  component "BusController\nGET /api/bus\nGET /api/bus/fleet-optimisation" as bCtrl
  component "DemandController\nGET /api/demand" as dCtrl
  component "MetroService\nBusService\nDemandService" as transitSvc
  component "MetroLineRepository\nBusRouteRepository\nTransitDemandRepository" as transitRepo
  component "[PLACEHOLDER]\nDpSchedulingService" as dpSched #lightgray
  mCtrl --> transitSvc
  mCtrl --> dpSched
  bCtrl --> transitSvc
  bCtrl --> dpSched
  dCtrl --> transitSvc
  transitSvc --> transitRepo
}
client --> mCtrl
client --> bCtrl
client --> dCtrl

' ──────────────────────────────────────────────
' graph (algorithms)
' ──────────────────────────────────────────────
package "graph" #FFEEEE {
  component "GraphController\nGET /api/graph/shortest-path\nGET /api/graph/mst\nGET /api/graph/astar\nGET /api/graph/time-varying-shortest-path\nGET /api/graph/prim-mst" as gCtrl
  component "GraphService\n(builds adjacency map)" as gSvc
  component "[IMPLEMENTED]\nDijkstraService" as dijkstra #lightgreen
  component "[IMPLEMENTED]\nKruskalMstService" as kruskal #lightgreen
  component "[PLACEHOLDER]\nAStarService" as astar #lightgray
  component "[PLACEHOLDER]\nTimeVaryingDijkstraService" as tvd #lightgray
  component "[PLACEHOLDER]\nPrimMstService" as prim #lightgray
  gCtrl --> dijkstra
  gCtrl --> kruskal
  gCtrl --> astar
  gCtrl --> tvd
  gCtrl --> prim
  dijkstra --> gSvc
  kruskal --> gSvc
  gSvc --> rRepo
  gSvc --> nodeRepo
}
client --> gCtrl

' ──────────────────────────────────────────────
' Seeder → DB
' ──────────────────────────────────────────────
database "H2 Database\n(file-based)" as db

seeder --> nhRepo
seeder --> fRepo
seeder --> rRepo
seeder --> tRepo
seeder --> transitRepo
nhRepo --> db
fRepo --> db
rRepo --> db
tRepo --> db
transitRepo --> db
nodeRepo --> db

@enduml
