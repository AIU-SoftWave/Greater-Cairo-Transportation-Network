@startuml api-flow-sequence
skinparam sequenceMessageAlign center
title Greater Cairo Transportation Network – API Request Flow\n(Dijkstra Shortest Path example)

actor     "HTTP Client"        as client
boundary  "GraphController"    as ctrl
control   "DijkstraService"    as svc
control   "GraphService"       as gsvc
entity    "RoadRepository"     as roadRepo
entity    "NodeRepository"     as nodeRepo
database  "H2 Database"        as db

== Startup (once) ==

note over db : H2 in-memory DB\nalready seeded by\nCsvDatabaseSeeder

== GET /api/graph/shortest-path?from=1&to=5 ==

client  -> ctrl    : GET /api/graph/shortest-path\n?from="1"&to="5"
activate ctrl

ctrl    -> svc     : findShortestPath("1", "5")
activate svc

svc     -> gsvc    : buildAdjacencyMap()
activate gsvc

gsvc    -> roadRepo : findAll()
activate roadRepo
roadRepo -> db      : SELECT * FROM roads JOIN nodes
db      --> roadRepo : List<Road>
deactivate roadRepo
gsvc    --> svc    : Map<nodeId, List<GraphEdge>>
deactivate gsvc

svc     -> gsvc    : buildNodeNameMap()
activate gsvc
gsvc    -> nodeRepo : findAll()
activate nodeRepo
nodeRepo -> db     : SELECT * FROM nodes
db      --> nodeRepo : List<AbstractNode>
deactivate nodeRepo
gsvc    --> svc    : Map<nodeId, name>
deactivate gsvc

note over svc
  Validate "1" and "5" exist
  in the adjacency map.
end note

svc     -> svc     : runDijkstra(adjacency, nameMap, "1", "5")
note right of svc
  Priority-queue Dijkstra loop
  with lazy-deletion.
  Stops at destination node "5".
end note

svc     -> svc     : reconstructPath(predecessor, nameMap, "1", "5")
note right of svc
  Walk predecessor map
  from "5" back to "1",
  then reverse.
end note

svc     --> ctrl   : ShortestPathResult\n{ found=true, stops=[…], totalDistanceKm=X }
deactivate svc

alt path found
  ctrl --> client  : 200 OK\n{ found, stops, totalDistanceKm }
else path not found
  ctrl --> client  : 404 Not Found
end
deactivate ctrl

@enduml
