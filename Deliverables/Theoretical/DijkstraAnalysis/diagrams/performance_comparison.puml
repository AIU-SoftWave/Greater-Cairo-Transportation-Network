@startuml PerformanceComparison
skinparam backgroundColor #FAFAFA
skinparam component {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Dijkstra vs A* — Performance Comparison (Cairo Network)

package "6 Route Scenarios Tested" {
    component "S1: Maadi - Cairo Univ.\nHospital: 8.2 km" as S1
    component "S2: Heliopolis - Nasr City:\n5.1 km" as S2
    component "S3: 6th October - Downtown:\n12.7 km" as S3
    component "S4: Zamalek - Madinaty:\n18.3 km" as S4
    component "S5: New Cairo - Giza:\n22.4 km" as S5
    component "S6: Shubra - Mohandessin:\n7.6 km" as S6
}

package "Performance Metrics" {
    component "Dijkstra Avg Nodes Expanded: 30.8\n(88% of network explored)" as M1
    component "A* Avg Nodes Expanded: 16.8\n(48% of network explored)" as M2
    component "Avg Reduction: 46.7%\nA* explores ~half the nodes" as M3
    component "Both produce identical\nshortest paths [OK]" as M4
}

package "Key Insights" {
    component "A* heuristic is admissible:\nh(n) = Euclidean distance\nh(n) <= delta(n,t) always" as I1
    component "A* consistent (monotone):\nh(u) <= w(u,v) + h(v)\nTriangle inequality holds" as I2
    component "When h ≡ 0, A* degenerates\nto Dijkstra exactly" as I3
}

S1 --> M1
S2 --> M1
S3 --> M1
S4 --> M1
S5 --> M1
S6 --> M1

M1 --> I1
M2 --> I2
M3 --> I3

note bottom of M1
  **Dijkstra explores all nodes**
  within cost radius. For Cairo's
  35-node network, this means
  expanding ~31 nodes on average.
end note

note bottom of M2
  **A* uses heuristic to guide**
  search toward target. Expands
  only nodes "in direction" of goal,
  reducing nodes by ~47%.
end note

@enduml
