---
title: "Dijkstra's Algorithm – Main Control Flow"
---
flowchart TD
    A([▶ START]) --> B["Validate fromNodeId & toNodeId\nexist in graph.NodeIndex"]
    B -- "❌ Missing node" --> FAIL1([✖ Return Found = false])
    B -- "✅ Both exist" --> C{"fromNodeId\n== toNodeId?"}
    C -- "Yes" --> SAME([✔ Return distance = 0\nsingle-node path])
    C -- "No" --> D

    D["**INIT DATA STRUCTURES**\ndist[s] = 0, dist[v≠s] = ∞\nvisited = {}\nprev_node = {}, prev_road = {}\nPQ ← (s, 0)"]

    D --> LOOP{PQ empty?}
    LOOP -- "Yes → no path" --> FAIL2([✖ Return Found = false])
    LOOP -- "No" --> E["u ← PQ.Dequeue()\n(node with min dist)"]

    E --> VIS{"u already\nin visited?"}
    VIS -- "Yes → stale entry" --> LOOP
    VIS -- "No" --> F["visited.Add(u)\nmetrics.MarkExpanded()"]

    F --> TGT{"u == toNodeId?"}
    TGT -- "Yes" --> RECON["**EARLY TERMINATION** ✓\nReconstruct path via\nprev_node / prev_road"]
    TGT -- "No" --> G["For each edge e\nin AdjacencyList[u]"]

    G --> H["newDist = dist[u] + e.Distance"]
    H --> RELAX{"newDist\n< dist[e.to]?"}
    RELAX -- "No – skip" --> G
    RELAX -- "Yes – relax!" --> I["dist[e.to] = newDist\nprev_node[e.to] = u\nprev_road[e.to] = e.Id\nPQ.Enqueue(e.to, newDist)"]
    I --> G
    G -- "all neighbors done" --> LOOP

    RECON --> BACK["Walk backward:\ntarget → … → source"]
    BACK --> REV["Reverse node & road lists"]
    REV --> RET([✔ Return ShortestPathResultDto\ndist, PathNodes, PathRoads])

    style A fill:#4CAF50,color:#fff
    style RET fill:#4CAF50,color:#fff
    style SAME fill:#4CAF50,color:#fff
    style FAIL1 fill:#F44336,color:#fff
    style FAIL2 fill:#F44336,color:#fff
    style D fill:#2196F3,color:#fff
    style I fill:#FF9800,color:#fff
    style RECON fill:#9C27B0,color:#fff
